# Clerk: use the SAME Clerk application as the mobile app so users and roles are shared.
# Dashboard -> API Keys. The publishable key is public; the secret key must never be
# committed, shared, or given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Supabase: Project Settings -> API Keys. Use the SECRET key (sb_secret_...), server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# INFI-PAY: server-only, for collecting payment on the app's own Starter/Pro plans
# (not the individual subscriptions users track). Never give these a NEXT_PUBLIC_/
# EXPO_PUBLIC_ prefix and never reference them from mobile code.
INFI_PAY_API_URL=
INFI_PAY_API_KEY=
INFI_PAY_WEBHOOK_SECRET=
