# Clerk: use the SAME Clerk application as the mobile app so users and roles are shared.
# Dashboard -> API Keys. The publishable key is public; the secret key must never be
# committed, shared, or given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Supabase: Project Settings -> API Keys. Use the SECRET key (sb_secret_...), server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# INFI-PAY: server-only, for collecting payment on the app's own Starter/Pro plans
# (not the individual subscriptions users track). Never give these a NEXT_PUBLIC_/
# EXPO_PUBLIC_ prefix and never reference them from mobile code.
# Base URL from the INFI-PAY docs.
INFI_PAY_API_URL=https://api.infi-pay.com/api/v1
# Dashboard -> API Keys. Grant ONLY the scopes payments.initiate and
# payments.read. Shown once at creation — paste it here, never into code/chat.
INFI_PAY_API_KEY=
# Dashboard -> Webhooks -> register https://<admin-host>/api/payments/webhook
# for payment.success and payment.failed. The signing secret is shown once.
INFI_PAY_WEBHOOK_SECRET=
# "sandbox" or "production" — required, so a sandbox deployment can never be
# mistaken for a live one. Use sandbox credentials first; never put production
# credentials in a development environment.
INFI_PAY_ENVIRONMENT=
# Optional: our HTTP timeout for calls to INFI-PAY, in ms (default 15000).
INFI_PAY_TIMEOUT_MS=

# Scheduled pending-payment recovery (GET/POST /api/internal/payments/recover
# with "Authorization: Bearer <CRON_SECRET>"). Leave empty to disable the endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# PROVISIONAL pending-payment policy (depends on INFI-PAY's real SLA, which is
# unknown). Pending payments are NEVER auto-failed; these only control when we
# ask INFI-PAY about one, and when it is flagged for manual review.
PAYMENT_RECOVERY_MIN_AGE_MINUTES=10
PAYMENT_PENDING_REVIEW_AFTER_HOURS=24
