# Mobile app (Expo). EVERYTHING here is bundled into the app and readable by
# anyone who has it — only public values belong here. Never put Supabase keys,
# Clerk secret keys, INFI-PAY credentials or webhook secrets in this file.
# Copy to .env.local and fill in.

# Clerk -> API Keys -> Publishable key (pk_...). Same Clerk application as admin/.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The admin/API server as the phone can reach it. For local development use
# your computer's LAN IP, not localhost, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=
